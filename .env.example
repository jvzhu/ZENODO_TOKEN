# Copy this file to .env and fill with real values locally.
# NEVER commit real tokens.

# Zenodo API token (create in your Zenodo account settings)
ZENODO_TOKEN=your_zenodo_token_here

# API base URL
ZENODO_API_BASE_URL=https://zenodo.org/api

# Optional: Use Zenodo sandbox for testing
# ZENODO_API_BASE_URL=https://sandbox.zenodo.org/api
